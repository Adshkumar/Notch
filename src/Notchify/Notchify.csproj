<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Keep the existing code namespace while branding the application as Notro. -->
    <AssemblyName>Notro</AssemblyName>
    <RootNamespace>Notchify</RootNamespace>
    <Version>0.4.0</Version>
    <Product>Notro</Product>
    <AssemblyTitle>Notro</AssemblyTitle>
    <Authors>Adarsh Kumar</Authors>
    <Company>Adarsh Kumar</Company>
    <Copyright>© 2026 Adarsh Kumar</Copyright>
    <Description>An open-source, fully customizable Dynamic-Island style notch for Windows.</Description>
    <ApplicationIcon>Assets\Notro.ico</ApplicationIcon>
    <!-- Lets the project compile on macOS/Linux CI. It only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);CA1416;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon and screen enumeration; keep its namespaces out of the global scope. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Notro.ico" />
    <Resource Include="Assets\Notro-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
